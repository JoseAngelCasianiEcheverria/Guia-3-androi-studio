<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contenedor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary"
        app:trackThickness="2dp" />

    <ScrollView
        android:id="@+id/desplaz_credenciales"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/espacio_lg"
            android:paddingTop="@dimen/espacio_xl"
            android:paddingEnd="@dimen/espacio_lg"
            android:paddingBottom="@dimen/espacio_xl">

            <ImageView
                android:layout_width="@dimen/marca_lamina"
                android:layout_height="@dimen/marca_lamina"
                android:contentDescription="@string/marca_organizacion_descripcion"
                android:src="@drawable/ic_luffy" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_md"
                android:text="@string/marca_organizacion"
                android:textAppearance="@style/TextAppearance.Taller3.Estarcido"
                android:textColor="@color/md_on_surface_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Taller3.TituloPantalla"
                android:textColor="@color/md_on_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_sm"
                android:layout_marginBottom="@dimen/espacio_xl"
                android:gravity="center_horizontal"
                android:text="@string/subtitulo_organizacion"
                android:textAppearance="@style/TextAppearance.Taller3.Mono"
                android:textColor="@color/md_on_surface_variant" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/capa_correo"
                style="@style/Widget.Taller3.CampoTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/etiqueta_correo"
                app:helperTextTextAppearance="@style/TextAppearance.Taller3.Mono">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campo_correo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/capa_clave"
                style="@style/Widget.Taller3.CampoTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_sm"
                android:hint="@string/etiqueta_clave"
                app:endIconMode="password_toggle"
                app:helperTextTextAppearance="@style/TextAppearance.Taller3.Mono">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campo_clave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/capa_nombre"
                style="@style/Widget.Taller3.CampoTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_sm"
                android:hint="@string/etiqueta_nombre"
                android:visibility="gone"
                app:helperText="@string/ayuda_nombre"
                app:helperTextTextAppearance="@style/TextAppearance.Taller3.Mono">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campo_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:imeOptions="actionDone"
                    android:inputType="textPersonName"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/caso_registro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_md"
                android:minHeight="@dimen/objetivo_toque"
                android:text="No tienes cuenta? Crea una"
                android:textAppearance="@style/TextAppearance.Taller3.MonoEtiqueta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ingresar"
                style="@style/Widget.Taller3.Boton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_md"
                android:text="@string/accion_ingresar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_salir"
                style="@style/Widget.Taller3.BotonTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs"
                android:text="@string/accion_salir" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_servidor"
                style="@style/Widget.Taller3.BotonTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/etiqueta_servidor" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/capa_servidor"
                style="@style/Widget.Taller3.CampoTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espacio_sm"
                android:hint="@string/etiqueta_servidor"
                android:visibility="gone"
                app:helperText="@string/ayuda_servidor"
                app:helperTextTextAppearance="@style/TextAppearance.Taller3.Mono">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campo_servidor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
