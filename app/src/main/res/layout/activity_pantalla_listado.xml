<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contenedor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/barra_superior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_surface"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barra"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_surface"
            app:subtitleTextAppearance="@style/TextAppearance.Taller3.MonoEtiqueta"
            app:subtitleTextColor="@color/md_on_surface_variant"
            app:title="@string/titulo_lista"
            app:titleTextAppearance="@style/TextAppearance.Taller3.TituloPantalla"
            app:titleTextColor="@color/md_on_surface" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/regla" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="?attr/colorPrimary"
            app:trackThickness="2dp" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <HorizontalScrollView
            android:id="@+id/desplaz_indice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_surface_container"
            android:contentDescription="@string/indice_etiqueta"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/indice_letras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/espacio_sm"
                android:paddingTop="@dimen/espacio_xs"
                android:paddingEnd="@dimen/espacio_sm"
                android:paddingBottom="@dimen/espacio_xs" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_usuarios"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@drawable/regla"
                android:dividerHeight="1dp"
                android:paddingBottom="96dp"
                android:scrollbars="vertical" />

            <LinearLayout
                android:id="@+id/estado_vacio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/espacio_xl"
                android:paddingEnd="@dimen/espacio_xl"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icono_estado"
                    android:layout_height="@dimen/icono_estado"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ficha_vacia" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_md"
                    android:text="@string/vacio_titulo"
                    android:textAppearance="@style/TextAppearance.Taller3.Sello"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:id="@+id/vacio_detalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_sm"
                    android:gravity="center_horizontal"
                    android:text="@string/vacio_detalle"
                    android:textAppearance="@style/TextAppearance.Taller3.Mono"
                    android:textColor="@color/md_on_surface_variant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/estado_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/espacio_xl"
                android:paddingEnd="@dimen/espacio_xl"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icono_estado"
                    android:layout_height="@dimen/icono_estado"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sin_conexion" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_md"
                    android:text="@string/error_conexion_titulo"
                    android:textAppearance="@style/TextAppearance.Taller3.Sello"
                    android:textColor="@color/md_error" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_sm"
                    android:gravity="center_horizontal"
                    android:text="@string/error_conexion_detalle"
                    android:textAppearance="@style/TextAppearance.Taller3.Mono"
                    android:textColor="@color/md_on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reintentar"
                    style="@style/Widget.Taller3.BotonTonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_md"
                    android:text="@string/accion_reintentar"
                    app:icon="@drawable/ic_reintentar" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_agregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/espacio_md"
        android:contentDescription="@string/accion_agregar"
        app:backgroundTint="@color/md_primary_container"
        app:srcCompat="@drawable/ic_mas"
        app:tint="@color/md_on_primary_container" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
