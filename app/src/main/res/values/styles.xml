<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.Taller3.Estarcido" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Taller3.Mono" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Taller3.MonoEtiqueta" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Taller3.FilaNombre" parent="TextAppearance.Material3.TitleMedium" />

    <style name="TextAppearance.Taller3.Sello" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Taller3.TituloPantalla" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Taller3.CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">@dimen/grosor_regla</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radio_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radio_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radio_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radio_control</item>
        <item name="hintTextAppearance">@style/TextAppearance.Taller3.Estarcido</item>
    </style>

    <style name="Widget.Taller3.Boton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/boton_altura</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="cornerRadius">@dimen/radio_control</item>
        <item name="android:textAppearance">@style/TextAppearance.Taller3.Estarcido</item>
    </style>

    <style name="Widget.Taller3.BotonTonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/boton_altura</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="cornerRadius">@dimen/radio_control</item>
        <item name="android:textAppearance">@style/TextAppearance.Taller3.Estarcido</item>
    </style>

    <style name="Widget.Taller3.BotonTexto" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/objetivo_toque</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textAppearance">@style/TextAppearance.Taller3.Estarcido</item>
    </style>

    <style name="Widget.Taller3.BotonError" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/boton_altura</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="cornerRadius">@dimen/radio_control</item>
        <item name="android:textColor">?attr/colorError</item>
        <item name="backgroundTint">?attr/colorErrorContainer</item>
        <item name="iconTint">?attr/colorOnErrorContainer</item>
        <item name="android:textAppearance">@style/TextAppearance.Taller3.Estarcido</item>
    </style>

    <style name="Widget.Taller3.LetraIndice" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">@dimen/objetivo_toque</item>
        <item name="android:minHeight">@dimen/objetivo_toque</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Taller3.MonoEtiqueta</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Taller3.LetraIndice.Activa" parent="Widget.Taller3.LetraIndice">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.Taller3.DialogoTear" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Taller3.Dialogo</item>
    </style>

    <style name="ShapeAppearanceOverlay.Taller3.Dialogo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radio_lamina</item>
        <item name="cornerSizeTopRight">@dimen/radio_lamina</item>
        <item name="cornerSizeBottomLeft">@dimen/radio_lamina</item>
        <item name="cornerSizeBottomRight">@dimen/radio_lamina</item>
    </style>

</resources>
